{
  "name": "banana-lesson",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Action English — learn everyday English verbs from animated actions.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
